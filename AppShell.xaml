<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Lessop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Lessop"
    xmlns:resx="clr-namespace:Lessop.Resources.Strings"
    Shell.BackgroundColor="Black"
    Shell.TabBarBackgroundColor="Black"
    FlyoutBackgroundColor="Black"
    Title="Lessop">
    <ShellContent
        Title="{x:Static resx:AppResources.Title}"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="{x:Static resx:AppResources.TitleToAddLesson}"
        ContentTemplate="{DataTemplate local:AddLessonPage}"
        Route="AddLessonPage" />
    <ShellContent
        Title="{x:Static resx:AppResources.TitleToViewLesson}"
        ContentTemplate="{DataTemplate local:ViewLessonPage}"
        Route="ViewLessonPage" />
    <ShellContent
        Title="{x:Static resx:AppResources.DiaryTitle}"
        ContentTemplate="{DataTemplate local:Diary}"
        Route="Diary" />
</Shell>
