<?xml version="1.0" encoding="utf-8" ?>
<diary:DiaryDayPage xmlns:diary="clr-namespace:Lessop" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             WidthRequest="1000"
             x:Class="Lessop.MondayPage"
             xmlns:local="clr-namespace:Lessop.Resources.Strings"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker">

    <ScrollView>
        <Grid x:Name="MyGrid"
              Padding="10"
              RowSpacing="10"
              ColumnSpacing="10"
              BackgroundColor="#353535">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Fill">
                <StackLayout Orientation="Vertical"  x:Name="HOChange"/>
            </StackLayout>

            <StackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" x:Name="PickerStack"/>
            <StackLayout Grid.Row="0" Grid.Column="2" HorizontalOptions="Fill" >
                <StackLayout Orientation="Vertical" x:Name="HOChange2"/>
            </StackLayout>
            <Button Grid.Row="1" Grid.Column="0" Text="{Binding Source={x:Static local:AppResources.AddNewlessonShe}, Converter={StaticResource ResourceConverter}}" Clicked="OnAddTimePickerClicked"/>
            <Button Grid.Row="1" Grid.Column="2" Text="{Binding Source={x:Static local:AppResources.RemoveLastLesson}, Converter={StaticResource ResourceConverter}}" Clicked="OnRemoveTimePickerClicked"/>
            <Button Text="{Binding Source={x:Static local:AppResources.SaveButton}, Converter={StaticResource ResourceConverter}}" FontSize="Medium" Grid.Row="1" Grid.Column="1" Clicked="SaveClicked"/>
            <Button Text="{Binding Source={x:Static local:AppResources.ApplyTimeToAllDay}, Converter={StaticResource ResourceConverter}}" FontSize="Medium" Clicked="OnApplyToAllTimeClicked" Grid.Row="2" Grid.ColumnSpan="3"/>
        </Grid>
    </ScrollView>
</diary:DiaryDayPage>
